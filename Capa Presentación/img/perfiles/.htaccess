# Fotos subidas por los usuarios: nunca se ejecutan como código.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Solo se sirven los archivos con el nombre que genera el servidor (perfil_<id>.png)
Require all denied
<FilesMatch "^perfil_[0-9]+\.png$">
    Require all granted
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'"
</IfModule>
